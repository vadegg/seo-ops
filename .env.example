# --- Codex subscription ---
# Run `codex login` once as the cron user. Do not set OPENAI_API_KEY here.
CODEX_BIN=/home/clawd/.local/bin/codex
CODEX_TIMEOUT=600

# --- Google Search Console (service account) ---
# Absolute path to the service-account JSON key file on the VPS.
GSC_SERVICE_ACCOUNT_JSON=/opt/seo-autoblog/secrets/gsc-sa.json
# Property as registered in Search Console (sc-domain:example.com or https://example.com/).
GSC_SITE_URL=sc-domain:glasgowresearch.com

# --- DataForSEO (optional; set both values to enable paid keyword data) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Telegram (Bot API alert channel) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# --- Blog repo (Astro, autodeploy on push) ---
BLOG_REPO_URL=git@github.com:vadegg/glasgow-blog.git
# Absolute path to the SSH deploy key with push rights to BLOG_REPO_URL.
GIT_DEPLOY_KEY=/opt/seo-autoblog/secrets/blog_deploy_ed25519
# Branch to publish to (prod). Use a staging branch for dry-runs.
BLOG_BRANCH=main
# Relative path inside the blog repo where post .md files live.
BLOG_POSTS_DIR=src/content/blog
# Public base URL of a post (used for internal-link + IndexNow URLs).
# MUST match the live route: <base>/<slug>/ — e.g. blog.glasgow.works/blog/<slug>/.
BLOG_BASE_URL=https://blog.glasgow.works/blog
DEPLOYMENT_TIMEOUT=300
# Weekly search performance reports and an existing-page review queue.
WORKSPACE_ROOT=/home/clawd/seo/thematic-workspace

# --- Evidence corpus (synced privately, NOT in git) ---
EVIDENCE_DIR=/opt/seo-autoblog/evidence

# --- Ark (ark-agent-fleet): чекаут репо-журнала флота на этом хосте. ---
# Задан → финальный шаг прогона пишет отчёт в общий журнал через
# $ARK_REPO/ark/river-report-flow/publish-cli.ts. Пусто → отправка отключена
# (отчёт всё равно пишется локально в runs/<дата>/report.json).
# Требуется: чекаут репо + `npm install` в ark/river-report-flow.
ARK_REPO=/home/clawd/ark-agent-fleet
# Локация зверя во флоте: zoo (VPS) или homestead. Дефолт paths.ts — homestead,
# поэтому на VPS ОБЯЗАТЕЛЬНО zoo, иначе отчёт ляжет не в ту партицию.
ARK_ZOO=zoo
# 1 → писать отчёт локально, но не коммитить/пушить в общий журнал (для отладки).
# ARK_NO_SYNC=
# node для publish-cli — нужен v22+ (нативный запуск .ts). Абсолютный путь, т.к.
# у cron урезанный PATH. Пусто → берётся из PATH (which node).
NODE_BIN=/usr/bin/node

# --- IndexNow (post-publish indexation ping; empty key disables it) ---
# Ownership proven by a key file served at <site>/<key>.txt on the live blog.
INDEXNOW_KEY=129ebf08-3db2-4d2f-bf33-9ea41ef4cc90
# Site origin (no path). Defaults to the origin of BLOG_BASE_URL if unset.
INDEXNOW_SITE_URL=https://blog.glasgow.works
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# --- Tunables (optional, sensible defaults in config.py) ---
MAX_STAGE=4
AGENT_MAX_TOKENS=8000
MODEL_SONNET=gpt-5.6-terra
MODEL_OPUS=gpt-5.6-sol
TIMEZONE=Europe/Lisbon
SITE_NAME=Glasgow Research
# Post author — must match an author defined in the blog's src/data/site.ts.
AUTHOR_NAME=Vadim Glazkov
AUTHOR_SLUG=vadim
DEFAULT_CATEGORY=Research
# Keyword backlog hygiene: drop candidates scoring below the floor, keep the
# top BACKLOG_MAX_SIZE by score after each publish.
BACKLOG_SCORE_FLOOR=0.4
BACKLOG_MAX_SIZE=50
